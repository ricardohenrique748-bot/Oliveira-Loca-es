# Copie para supabase/functions/.env (local) ou cadastre como secrets no projeto:
#   npx supabase secrets set --env-file supabase/functions/.env
#
# sandbox (testes) ou producao
SICREDI_AMBIENTE=sandbox
# x-api-key do app criado em https://developer.sicredi.com.br
SICREDI_API_KEY=
# Código de acesso gerado no Internet Banking Sicredi (Cobrança → Código de acesso).
# Com mais de um beneficiário (ex.: Oliveira e TDTS), use uma linha por código:
#   SICREDI_CODIGO_ACESSO_12345=...
SICREDI_CODIGO_ACESSO=
